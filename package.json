{
  "name": "gla-serverless",
  "version": "0.1.0",
  "bin": {
    "gla-serverless": "bin/gla-serverless.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "install-frontend": "cd ./services/frontend && npm ci",
    "build-frontend": "cd ./services/frontend && npm run build",
    "develop-frontend": "cd ./services/frontend && npm run dev",
    "synth-dev": "cdk synth -c STAGE=dev",
    "synth-prod": "cdk synth -c STAGE=prod",
    "deploy-dev": "cdk deploy --require-approval never -c STAGE=dev --all",
    "deploy-prod": "cdk deploy --require-approval never -c STAGE=prod --all"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "22.7.9",
    "aws-cdk": "2.178.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.749.0",
    "@aws-sdk/lib-dynamodb": "^3.749.0",
    "@aws-sdk/util-dynamodb": "^3.749.0",
    "@types/aws-lambda": "^8.10.147",
    "aws-cdk-lib": "2.178.2",
    "constructs": "^10.0.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  }
}
